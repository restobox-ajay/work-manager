# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> domains ###
# The app's host (FEATURE-131 / ADR-029). REQUIRED — the app fails to boot without it, because
# framework.trusted_hosts is derived from it (an empty value would compile to a match-all regex
# and silently disable host protection). It is matched as a host regex by the security firewall.
# Dev default = localhost; override in .env.local (e.g. modexbyte-work-manager.local).
# (ADMIN_DOMAIN is gone: since ADR-068 there is no separate admin area to put on its own host.)
APP_DOMAIN=localhost
# Domain attribute for the session + remember-me cookies. Leave EMPTY to scope
# cookies to the exact host that set them (per-host isolation).
SESSION_COOKIE_DOMAIN=
###< domains ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# ====================================================================================
# THIS APPLICATION IS MYSQL-ONLY (MySQL 8.0+, utf8mb4, InnoDB — ADR-066).
# The default below is a local WAMP MySQL (root, no password). Put real credentials in
# the gitignored .env.local, e.g.:
#   DATABASE_URL="mysql://USER:PASS@127.0.0.1:3306/work_manager?serverVersion=8.0.32&charset=utf8mb4"
# The app refuses any non-mysql:// URL at connect time (App\Doctrine\MysqlConnectionMiddleware).
# ====================================================================================
DATABASE_URL="mysql://root:@127.0.0.1:3306/work_manager?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# Deliberate duplicate, OUTSIDE the Flex markers above so a future `composer
# recipes:update` regenerating that block (which may reintroduce MySQL examples or
# comment this out) cannot change the effective value — .env is parsed top-to-bottom
# and the LAST definition of a key wins. Still MySQL-only. See the block above.
DATABASE_URL="mysql://root:@127.0.0.1:3306/work_manager?serverVersion=8.0.32&charset=utf8mb4"

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
