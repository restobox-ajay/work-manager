{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{#
    Request Payment (ADR-103, ADR-110): one client at a time — its approved tasks not yet invoiced, one block per
    currency (one invoice each).
    Each block is its own GET form to the approved-tasks invoice form, with then=email so saving leads to the email.
#}
{% block title %}Request Payment{% endblock %}

{% macro money(h, currency) %}{{ (h / 100)|number_format(2, '.', '')|invoice_money(currency) }}{% endmacro %}

{% block body %}
{% import _self as rp %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Request Payment</div>
        <div class="ph-title"><h1>Approved tasks to invoice</h1></div>
        <p class="lead">Choose a client to see its approved tasks that are not on an invoice yet. Tick the tasks to bill, then <b>Generate invoice &amp; email</b>: check the invoice, save it, and send it to the client.</p>
    </div>
    <div class="ph-actions"><a class="btn info" href="{{ path('app_invoice_index') }}">All invoices</a></div>
</div>
{{ ui.flashes() }}

<form class="table-card mx-form" method="get" action="{{ path('app_request_payment') }}" style="margin-bottom:16px">
    <div class="table-header">
        <label for="f-client" class="bold">Client</label>
        <select id="f-client" name="clientId" style="width:auto" onchange="this.form.submit()">
            <option value="">{{ clients is empty ? 'No client has approved tasks to invoice' : '— Choose a client —' }}</option>
            {% for c in clients %}<option value="{{ c.client.id }}" {{ client and client.id == c.client.id ? 'selected' }}>{{ c.client.name }} ({{ c.count }} task{{ c.count == 1 ? '' : 's' }})</option>{% endfor %}
        </select>
        <noscript><button class="btn primary sm" type="submit">Show</button></noscript>
        <span class="grow"></span>
    </div>
</form>

{% for g in groups %}
    <form class="table-card rp-group mx-form" method="get" action="{{ path('app_invoice_new_tasks') }}" style="margin-top:16px" data-currency="{{ g.currency }}">
        <input type="hidden" name="clientId" value="{{ g.client.id }}">
        <input type="hidden" name="currency" value="{{ g.currency }}">
        <input type="hidden" name="then" value="email">
        <div class="table-header">
            <b>{{ g.client.name }}</b>{% if g.client.companyName %}<span class="muted">· {{ g.client.companyName }}</span>{% endif %}
            <span class="badge plain">{{ g.currency }}</span>
            <span class="muted">{{ g.client.email ?: 'no email on file' }}</span>
            <span class="grow"></span>
            <span class="bold">{{ g.tasks|length }} task{{ g.tasks|length == 1 ? '' : 's' }} · {{ rp.money(g.total, g.currency) }}</span>
        </div>
        <div class="tscroll">
            <table class="t">
                <thead><tr>
                    <th style="width:36px"><input type="checkbox" data-check-all aria-label="Select all tasks of {{ g.client.name }}"></th>
                    <th>Task</th><th>Project</th><th>Contractor</th><th>Approved</th><th class="num right">Amount</th>
                </tr></thead>
                <tbody>
                    {% for t in g.tasks %}
                        <tr>
                            <td><input type="checkbox" name="taskIds[]" value="{{ t.id }}" data-amount="{{ t.totalAmount ?? '0.00' }}" aria-label="Include task #{{ t.id }}"></td>
                            <td><a href="{{ path('app_task_view', {id: t.id}) }}">#{{ t.id }} {{ ui.short(t.name, 80) }}</a></td>
                            <td>{% if t.project %}<a href="{{ path('app_project_view', {id: t.project.id}) }}">{{ t.project.name }}</a>{% else %}—{% endif %}</td>
                            <td>{{ t.assignee ? (t.assignee.name ?: t.assignee.email) : '—' }}</td>
                            <td class="nowrap">{{ t.approvedDate ? t.approvedDate|date('M j, Y') : '—' }}</td>
                            <td class="num right bold">{{ (t.totalAmount ?? '0.00')|invoice_money(g.currency) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="group-total">
                        <td colspan="5" class="right">Selected: <b data-selected-count>0 tasks</b></td>
                        <td class="num right bold" data-selected-total>{{ rp.money(0, g.currency) }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="table-foot">
            <span class="grow muted">Opens the invoice with the ticked tasks as lines; nothing is saved or sent until you confirm.</span>
            <button class="btn success" type="submit">Generate invoice &amp; email</button>
        </div>
    </form>
{% else %}
    {% if clients is not empty %}
        <div class="card" style="margin-top:16px"><b>Choose a client</b> to see its approved tasks that are not on an invoice yet. {{ clients|length }} client{{ clients|length == 1 ? '' : 's' }} {{ clients|length == 1 ? 'has' : 'have' }} work to invoice.</div>
    {% else %}
        <div class="card" style="margin-top:16px"><b>Nothing to invoice.</b> Approved tasks that are not on an invoice yet will appear here, one client at a time.</div>
    {% endif %}
{% endfor %}

{% if noClient is not empty %}
    <div class="card" style="margin-top:16px">
        <b>{{ noClient|length }} approved task{{ noClient|length == 1 ? '' : 's' }} without a client</b>
        <p class="muted">An invoice needs a client: give these tasks a project with a client first.</p>
        <ul>{% for t in noClient %}<li><a href="{{ path('app_task_view', {id: t.id}) }}">#{{ t.id }} {{ ui.short(t.name, 80) }}</a></li>{% endfor %}</ul>
    </div>
{% endif %}

<script>
    // Nothing is ticked at first. The header checkbox ticks / unticks every task; the footer shows how many are ticked
    // and their total; a block with nothing ticked cannot be submitted. (The invoice form recomputes everything.)
    document.querySelectorAll('.rp-group').forEach(function (form) {
        var all = form.querySelector('[data-check-all]');
        var boxes = form.querySelectorAll('input[name="taskIds[]"]');
        var button = form.querySelector('button[type=submit]');
        var count = form.querySelector('[data-selected-count]');
        var total = form.querySelector('[data-selected-total]');
        var symbols = { USD: '$', CAD: '$', AUD: '$', INR: '₹', EUR: '€', GBP: '£' };
        var code = form.dataset.currency || 'USD';
        function hundredths(value) {
            var m = String(value || '0').match(/^(-?)(\d+)(?:\.(\d{1,2}))?$/);
            return m ? (m[1] ? -1 : 1) * (parseInt(m[2], 10) * 100 + parseInt(((m[3] || '') + '00').slice(0, 2), 10)) : 0;
        }
        function money(h) {
            return (symbols[code] || code + ' ') + (Math.floor(h / 100)).toLocaleString('en-US') + '.' + String(h % 100).padStart(2, '0');
        }
        function sync() {
            var ticked = 0, sum = 0;
            boxes.forEach(function (b) { if (b.checked) { ticked++; sum += hundredths(b.dataset.amount); } });
            all.checked = ticked > 0 && ticked === boxes.length;
            all.indeterminate = ticked > 0 && ticked < boxes.length;
            button.disabled = ticked === 0;
            count.textContent = ticked + ' task' + (ticked === 1 ? '' : 's');
            total.textContent = money(sum);
        }
        all.addEventListener('change', function () { boxes.forEach(function (b) { b.checked = all.checked; }); sync(); });
        boxes.forEach(function (b) { b.addEventListener('change', sync); });
        sync();
    });
</script>
{% endblock %}
