{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{% block title %}Clients{% endblock %}

{% block body %}
{% set params = {name: name, status: status, sort: sort} %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Work</div>
        <div class="ph-title"><h1>Clients</h1></div>
        <p class="lead">Archived clients stay listed under the Archive filter; their projects' tasks leave the unfiltered task list.</p>
    </div>
    {% if is_granted('CLIENT_CREATE') %}
        <div class="ph-actions"><a class="btn success" href="{{ path('app_client_create') }}">+ Add new client</a></div>
    {% endif %}
</div>

{{ ui.flashes() }}

<div class="table-card">
    {# The filter row under the column labels (ADR-136) belongs to this form; Enter in the name box submits it. #}
    <form id="client-filters" method="get" action="{{ path('app_client_index') }}">
        {% if sort %}<input type="hidden" name="sort" value="{{ sort }}">{% endif %}
        <button type="submit" hidden>Filter</button>
    </form>
    <div class="tscroll">
        <table class="t">
            <thead>
                <tr>
                    {{ ui.sortHeader('name', 'Name', sort, 'app_client_index', params) }}
                    {{ ui.sortHeader('clientCode', 'Client Code', sort, 'app_client_index', params) }}
                    <th>Projects</th>
                    {{ ui.sortHeader('email', 'Email', sort, 'app_client_index', params) }}
                    {{ ui.sortHeader('isActive', 'Status', sort, 'app_client_index', params) }}
                    {{ ui.sortHeader('createdAt', 'Created', sort, 'app_client_index', params) }}
                    <th></th>
                </tr>
                <tr class="col-filters">
                    <th><input type="search" name="name" form="client-filters" value="{{ name }}" placeholder="Search name" aria-label="Filter by client name"></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th>
                        <select name="status" form="client-filters" data-autosubmit aria-label="Filter by status">
                            <option value="">All</option>
                            <option value="active" {{ status == 'active' ? 'selected' }}>Active</option>
                            <option value="archived" {{ status == 'archived' ? 'selected' }}>Archive</option>
                        </select>
                    </th>
                    <th></th>
                    <th>{% if name or status %}<a class="btn secondary xs" href="{{ path('app_client_index', {sort: sort ?: null}) }}">Reset</a>{% endif %}</th>
                </tr>
            </thead>
            <tbody>
                {% for client in page.items %}
                    <tr>
                        <td><a href="{{ path('app_dashboard', {clientId: client.id}) }}" class="bold" title="Tasks of {{ client.name }} on the dashboard">{{ client.name }}</a>{% if client.companyName %}<div class="muted small">{{ client.companyName }}</div>{% endif %}</td>
                        <td>{{ client.clientCode ?? '—' }}</td>
                        <td>
                            {% set count = details.projectCounts[client.id] ?? 0 %}
                            {% if count > 0 %}<a href="{{ path('app_project_index', {clientId: client.id}) }}">{{ count }}</a>{% else %}0{% endif %}
                        </td>
                        <td>{{ client.email ?? '—' }}</td>
                        <td>{{ ui.activeBadge(client.active) }}</td>
                        <td class="nowrap">{{ ui.ts(client.createdAt) }}</td>
                        <td class="actions">
                            <a class="btn primary xs" href="{{ path('app_client_view', {id: client.id}) }}">View</a>
                            <a class="btn info xs" href="{{ path('app_task_index', {clientId: client.id}) }}">Tasks</a>
                            {% if is_granted('CLIENT_EDIT', client) %}<a class="btn warning xs" href="{{ path('app_client_edit', {id: client.id}) }}">Edit</a>{% endif %}
                            {% if is_granted('ROLE_ADMIN') %}<a class="btn danger xs" href="{{ path('app_client_delete', {id: client.id}) }}">Delete</a>{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="empty"><b>No clients found.</b>{% if name or status %} Try clearing the filters.{% endif %}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ ui.pager(page, 'app_client_index', params) }}
</div>
{% endblock %}
