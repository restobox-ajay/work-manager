{% extends 'base.html.twig' %}

{% block title %}Check Your Email{% endblock %}

{% block body %}
<h1>Check Your Email</h1>

<div class="confirmation">
    <p>If an account with that email address exists and is active, we have sent a magic login link to it.</p>
    <p>Please check your inbox (and spam folder) for the link. It will expire shortly.</p>
</div>

<p><a href="{{ path('app_login') }}">Back to login</a></p>
{% endblock %}
