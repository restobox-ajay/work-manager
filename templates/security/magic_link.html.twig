{% extends 'base.html.twig' %}

{% block title %}Magic Link Login{% endblock %}

{% block body %}
<h1>Magic Link Login</h1>

<p>Enter your email address and we will send you a passwordless login link.</p>

{% if error %}
    <div class="error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_magic_link') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('magic_link_request') }}">
    <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
    </div>
    <button type="submit" class="btn primary">Send Magic Link</button>
</form>

<p><a href="{{ path('app_login') }}">Back to login</a></p>
{% endblock %}
