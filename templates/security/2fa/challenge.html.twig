{% extends 'base.html.twig' %}

{% block title %}Two-Factor Authentication{% endblock %}

{% block body %}
<h1>Two-Factor Authentication</h1>

<p>Enter the 6-digit code from your authenticator app.</p>

<form method="post" action="{{ path('app_2fa_challenge') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('2fa_challenge') }}">

    {% if error %}
        <div class="error">{{ error }}</div>
    {% endif %}

    <div class="form-field">
        <label for="_code">Authentication Code</label>
        <input type="text"
               id="_code"
               name="_code"
               inputmode="numeric"
               autocomplete="one-time-code"
               maxlength="6"
               placeholder="000000"
               autofocus
               required>
    </div>

    <div class="form-field">
        <label>
            <input type="checkbox" name="_trust_device" value="1">
            Trust this device for {{ trusted_device_days }} days
        </label>
    </div>

    <button type="submit">Verify</button>
</form>
{% endblock %}
