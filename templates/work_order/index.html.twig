{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}
{% import 'work_order/_macros.html.twig' as wm %}

{% block title %}Work orders{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Work orders</div>
        <div class="ph-title"><h1>Work orders</h1></div>
        <p class="lead">Contracts and jobs you have won: scope, value, dates, milestones and the signed documents.</p>
    </div>
    <div class="ph-actions"><a class="btn success" href="{{ path('app_work_order_new') }}">+ New work order</a></div>
</div>
{{ ui.flashes() }}

<form class="table-card mx-form" method="get" action="{{ path('app_work_order_index') }}" style="margin-bottom:16px">
    <div class="table-header" style="flex-wrap:wrap">
        <input type="search" name="q" value="{{ q }}" placeholder="Title, number, client, contact or reference" aria-label="Search work orders" style="min-width:260px">
        <select name="status" aria-label="Status" style="width:auto" onchange="this.form.submit()">
            <option value="open" {{ status == 'open' ? 'selected' }}>Open (draft, active, on hold)</option>
            {% for k, label in statuses %}<option value="{{ k }}" {{ status == k ? 'selected' }}>{{ label }}</option>{% endfor %}
            <option value="all" {{ status == 'all' ? 'selected' }}>All</option>
        </select>
        <select name="clientId" aria-label="Client" style="width:auto" onchange="this.form.submit()">
            <option value="">All clients</option>
            {% for c in clients %}<option value="{{ c.id }}" {{ clientId == c.id ? 'selected' }}>{{ c.name }}</option>{% endfor %}
        </select>
        <button class="btn primary sm" type="submit">Filter</button>
        {% if q or clientId or status != 'open' %}<a class="btn secondary sm" href="{{ path('app_work_order_index') }}">Reset</a>{% endif %}
        <span class="grow"></span>
    </div>
</form>

{% if totals is not empty %}
<div class="kpis rent-kpis">
    {% for currency, t in totals %}
        <div class="kpi"><span>{{ currency }} · {{ t.count }} work order{{ t.count == 1 ? '' : 's' }}</span><b>{{ t.value|invoice_money(currency) }}</b>
            <small>Advance {{ t.advance|invoice_money(currency) }} · To receive {{ (t.value - t.advance)|invoice_money(currency) }}</small></div>
    {% endfor %}
</div>
{% endif %}

<div class="table-card" style="margin-top:16px">
    <div class="tscroll">
        <table class="t">
            <thead><tr><th>Number</th><th>Title</th><th>Client</th><th class="num">Value</th><th>Signed</th><th>Deadline</th><th>Status</th><th>Docs</th><th></th></tr></thead>
            <tbody>
                {% for w in workOrders %}
                    <tr>
                        <td class="nowrap"><a href="{{ path('app_work_order_show', {id: w.id}) }}">{{ w.number }}</a></td>
                        <td><a class="bold" href="{{ path('app_work_order_show', {id: w.id}) }}">{{ ui.short(w.title, 80) }}</a>{% if w.reference %}<div class="muted small">Ref. {{ w.reference }}</div>{% endif %}</td>
                        <td>{% if w.client %}<a href="{{ path('app_client_view', {id: w.client.id}) }}">{{ w.client.name }}</a>{% else %}{{ w.clientName ?: '—' }}{% endif %}
                            {% if w.contactName %}<div class="muted small">{{ w.contactName }}</div>{% endif %}</td>
                        <td class="num nowrap bold">{{ w.value is not null ? w.value|invoice_money(w.currency) : '—' }}</td>
                        <td class="nowrap">{{ w.signedDate ? w.signedDate|date('M j, Y') : '—' }}</td>
                        <td>{{ wm.deadline(w) }}</td>
                        <td>{{ wm.status(w.status, w.statusLabel) }}{% if w.project %}<div class="small"><a href="{{ path('app_project_view', {id: w.project.id}) }}">Project</a></div>{% endif %}</td>
                        <td>{{ fileCounts[w.id] ?? 0 }}</td>
                        <td class="actions">
                            <a class="btn primary xs" href="{{ path('app_work_order_show', {id: w.id}) }}">View</a>
                            <a class="btn warning xs" href="{{ path('app_work_order_edit', {id: w.id}) }}">Edit</a>
                            {{ ui.deleteButton(path('app_work_order_delete', {id: w.id}), 'work_order_delete_' ~ w.id, 'Delete work order ' ~ w.number ~ ' with its milestones and documents? This cannot be undone.') }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="9" class="empty"><b>No work orders here.</b> <a href="{{ path('app_work_order_new') }}">Add one</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
