{% extends 'base.html.twig' %}

{% block title %}New Admin{% endblock %}

{% block body %}
<h1>New Admin</h1>

{% if errors is not empty %}
    <div class="error">
        {% for error in errors %}<p>{{ error }}</p>{% endfor %}
    </div>
{% endif %}

<form method="post" action="{{ path('app_admin_superadmin_admins_new') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_admin_create') }}">

    <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="off" required>
    </div>

    <div>
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="off" required>
    </div>

    <div>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="new-password" required>
    </div>

    <div>
        <label for="role">Role</label>
        <select id="role" name="role">
            <option value="ROLE_ADMIN">Admin</option>
            <option value="ROLE_SUPER_ADMIN">Superadmin</option>
            {# Maintainer tier — offered only to tech-support viewers (ADR-050); the server
               coerces the value to ROLE_ADMIN for anyone else, like any unknown string. #}
            {% if is_granted('ROLE_TECH_SUPPORT') %}
            <option value="ROLE_TECH_SUPPORT">Tech Support</option>
            {% endif %}
        </select>
    </div>

    <button type="submit">Create Admin</button>
</form>

<p><a href="{{ path('app_admin_superadmin_admins') }}">Back to admin list</a></p>
{% endblock %}
