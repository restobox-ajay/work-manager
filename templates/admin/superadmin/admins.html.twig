{% extends 'base.html.twig' %}

{% block title %}Admin Management{% endblock %}

{% block body %}
<h1>Admin Accounts</h1>

{% for message in app.flashes('success') %}
    <div class="flash-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="error">{{ message }}</div>
{% endfor %}

<p><a href="{{ path('app_admin_superadmin_admins_new') }}" class="admin-create-link">New Admin</a></p>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for admin in admins %}
        <tr>
            <td class="admin-name">{{ admin.name }}</td>
            <td class="admin-email">{{ admin.email }}</td>
            <td>{{ admin.roles|join(', ') }}</td>
            <td class="admin-status">{{ admin.status }}</td>
            <td>
                <a href="{{ path('app_admin_superadmin_admins_edit', {id: admin.id}) }}" class="admin-edit-link">Edit</a>
                {% if is_granted('ROLE_TECH_SUPPORT') %}
                <a href="{{ path('app_admin_support_api_tokens', {adminId: admin.id}) }}" class="admin-api-tokens-link">API Tokens</a>
                {% endif %}

                <form method="post" action="{{ path('app_admin_superadmin_admins_reset_password', {id: admin.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_admin_reset_password_' ~ admin.id) }}">
                    <button type="submit" class="admin-reset-password-btn">Reset Password</button>
                </form>

                <form method="post" action="{{ path('app_admin_superadmin_admins_reset_2fa', {id: admin.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_admin_reset_2fa_' ~ admin.id) }}">
                    <button type="submit" class="admin-reset-2fa-btn">Reset 2FA</button>
                </form>

                {# Only offered when auth-impersonate-bundle is registered (FEATURE-142 / ADR-041); the
                   Twig global is undefined ⇒ hidden when the bundle is removed. #}
                {% if impersonation_available is defined and impersonation_available and impersonation_enabled and 'ROLE_SUPER_ADMIN' not in admin.roles and 'ROLE_TECH_SUPPORT' not in admin.roles %}
                <form method="post" action="{{ path('app_admin_superadmin_impersonate', {id: admin.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_impersonate_admin_' ~ admin.id) }}">
                    <button type="submit" class="impersonate-admin-btn">Impersonate</button>
                </form>
                {% endif %}

                <form method="post" action="{{ path('app_admin_superadmin_admins_delete', {id: admin.id}) }}" style="display:inline"
                      onsubmit="return confirm('Delete this admin account?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_admin_delete_' ~ admin.id) }}">
                    <button type="submit" class="admin-delete-btn">Delete</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5">No admin accounts found.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
