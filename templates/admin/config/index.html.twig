{% extends 'base.html.twig' %}

{% block title %}Configuration{% endblock %}

{% block body %}
<h1>Configuration</h1>

{% for message in app.flashes('success') %}
    <div class="flash-success">{{ message }}</div>
{% endfor %}

{% set errors = errors|default({}) %}
{% if errors is not empty %}
    <div class="flash-error">Some values were invalid and were not saved. Please correct the highlighted fields.</div>
{% endif %}

{% if pages is empty %}
    <p>No configuration pages registered.</p>
{% else %}
    {% for page in pages %}
        <section class="config-page" data-slug="{{ page.provider.slug }}">
            <h2>{{ page.provider.title }}</h2>
            <form method="post" action="{{ path('app_admin_config_save', {slug: page.provider.slug}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_config_save_' ~ page.provider.slug) }}">
                {% for key, field in page.provider.fields %}
                    <div class="form-field">
                        <label for="field_{{ key|replace({'.': '_'}) }}">{{ field.label }}</label>
                        {% if field.type == 'bool' %}
                            <input type="checkbox"
                                   id="field_{{ key|replace({'.': '_'}) }}"
                                   name="fields[{{ key }}]"
                                   value="1"
                                   {% if page.values[key] == '1' %}checked{% endif %}>
                        {% elseif field.type == 'int' %}
                            <input type="number"
                                   id="field_{{ key|replace({'.': '_'}) }}"
                                   name="fields[{{ key }}]"
                                   value="{{ page.values[key] ?? '' }}">
                        {% else %}
                            <input type="text"
                                   id="field_{{ key|replace({'.': '_'}) }}"
                                   name="fields[{{ key }}]"
                                   value="{{ page.values[key] ?? '' }}">
                        {% endif %}
                        {% if errors[key] is defined %}
                            <p class="field-error" data-field="{{ key }}">{{ errors[key] }}</p>
                        {% endif %}
                    </div>
                {% endfor %}
                <button type="submit" class="btn primary">Save</button>
            </form>
        </section>
    {% endfor %}
{% endif %}
{% endblock %}
