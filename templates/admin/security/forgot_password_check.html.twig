{% extends 'base.html.twig' %}

{% block title %}Admin — Check Your Email{% endblock %}

{% block body %}
<h1>Check Your Email</h1>

<div class="confirmation">
    <p>If an admin account with that email address exists, we have sent a password reset link to it.</p>
    <p>Please check your inbox (and spam folder) for the reset link. It will expire in 1 hour.</p>
</div>

<p><a href="{{ path('app_admin_login') }}">Back to admin login</a></p>
{% endblock %}
