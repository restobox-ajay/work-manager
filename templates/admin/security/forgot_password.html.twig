{% extends 'base.html.twig' %}

{% block title %}Admin — Forgot Password{% endblock %}

{% block body %}
<h1>Forgot Password</h1>

<p>Enter your admin email address and we will send you a link to reset your password.</p>

{% if error is defined and error %}
    <div class="error">{{ error }}</div>
{% endif %}

<form method="post" action="{{ path('app_admin_forgot_password') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_forgot_password') }}">
    <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required>
    </div>
    <button type="submit">Send Reset Link</button>
</form>

<p><a href="{{ path('app_admin_login') }}">Back to admin login</a></p>
{% endblock %}
