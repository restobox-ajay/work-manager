{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{#
    Activity Log (Logs menu, ADR-093): every audited action. Filter names (actor, action, date_from, date_to) and the
    "Total:" line / .entry-* cells are what the existing tests and the admin API read; area and outcome are new.
#}
{% block title %}Activity Log — Admin{% endblock %}

{% block body %}
{% set q = filters|filter((v, k) => k in ['actor', 'action', 'area', 'outcome', 'date_from', 'date_to'] and v is not empty) %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Logs</div>
        <div class="ph-title"><h1>Activity Log</h1></div>
        <p class="lead">Every recorded action: sign-ins, records created, changed and deleted, payments, settings changes and Password Manager events (never their contents).</p>
    </div>
    <div class="ph-actions"><a class="btn info" href="{{ path('app_admin_audit_log_export', q) }}">Export CSV</a></div>
</div>
{{ ui.flashes() }}
{% if filterError is defined and filterError %}
<div class="alert danger filter-error" role="alert">{{ filterError }}</div>
{% endif %}

<form class="table-card mx-form" method="get" action="{{ path('app_admin_audit_log') }}" style="margin-bottom:16px">
    <div class="form-grid log-filters">
        <div class="field"><label for="actor">User</label><input type="text" id="actor" name="actor" value="{{ filters.actor ?? '' }}" placeholder="email contains…"></div>
        <div class="field"><label for="area">Area</label>
            <select id="area" name="area"><option value="">All areas</option>{% for k, label in areas %}<option value="{{ k }}" {{ (filters.area ?? '') == k ? 'selected' }}>{{ label }}</option>{% endfor %}</select></div>
        <div class="field"><label for="action">Action</label>
            <select id="action" name="action"><option value="">All actions</option>{% for a in actions %}<option value="{{ a }}" {{ (filters.action ?? '') == a ? 'selected' }}>{{ a }}</option>{% endfor %}</select></div>
        <div class="field"><label for="outcome">Outcome</label>
            <select id="outcome" name="outcome"><option value="">Any</option>{% for o in ['success', 'failure'] %}<option value="{{ o }}" {{ (filters.outcome ?? '') == o ? 'selected' }}>{{ o|capitalize }}</option>{% endfor %}</select></div>
        <div class="field"><label for="date_from">From</label><input type="date" id="date_from" name="date_from" value="{{ filters.date_from ?? '' }}"></div>
        <div class="field"><label for="date_to">To</label><input type="date" id="date_to" name="date_to" value="{{ filters.date_to ?? '' }}"></div>
    </div>
    <div class="table-foot"><span class="grow">Total: {{ total }}</span><a class="btn secondary sm" href="{{ path('app_admin_audit_log') }}">Clear</a><button type="submit" class="btn primary sm">Filter</button></div>
</form>

<div class="table-card">
    <div class="tscroll">
        <table class="t">
            <thead><tr><th>When</th><th>User</th><th>Type</th><th>IP</th><th>Area</th><th>Action</th><th>Outcome</th><th>Details</th><th></th></tr></thead>
            <tbody>
                {% for entry in entries %}
                <tr class="audit-entry">
                    <td class="entry-time nowrap">{{ entry.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td class="entry-actor">{{ entry.actor }}</td>
                    <td class="entry-actor-type">{{ entry.actorType }}</td>
                    <td class="entry-ip nowrap">{{ entry.ip }}</td>
                    <td>{{ entryAreas[entry.id] }}</td>
                    <td class="entry-action"><code>{{ entry.action }}</code></td>
                    <td class="entry-outcome"><span class="badge {{ entry.outcome == 'success' ? 'success' : 'danger' }}">{{ entry.outcome }}</span></td>
                    <td class="small">{{ ui.short(entry.context ?? '', 80) ?: '—' }}</td>
                    <td class="actions"><a class="btn secondary xs" href="{{ path('app_admin_audit_log_show', {id: entry.id}) }}">Details</a></td>
                </tr>
                {% else %}
                <tr><td colspan="9" class="empty">No audit entries found.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ ui.pager({page: currentPage, pageSize: pageSize, total: total, pages: totalPages}, 'app_admin_audit_log', q) }}
</div>
{% endblock %}
