{% extends 'base.html.twig' %}

{% block title %}Email #{{ m.id }} — Admin{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Logs › Email Log</div>
        <div class="ph-title"><h1>{{ m.subject }}</h1> <span class="badge {{ {sent: 'success', queued: 'warn', failed: 'danger'}[m.status] ?? 'plain' }}">{{ m.status|capitalize }}</span></div>
        <p class="lead">{{ m.createdAt|date('Y-m-d H:i:s') }} UTC</p>
    </div>
    <div class="ph-actions"><a class="btn secondary back" href="{{ path('app_admin_email_log') }}">Back</a></div>
</div>
<div class="card">
    <table class="t v-kv">
        <tr><th>From</th><td>{{ m.sender ?: '—' }}</td></tr>
        <tr><th>To</th><td>{{ m.recipients }}</td></tr>
        <tr><th>Cc</th><td>{{ m.cc ?: '—' }}</td></tr>
        <tr><th>Bcc</th><td>{{ m.bcc ?: '—' }}</td></tr>
        <tr><th>Subject</th><td>{{ m.subject }}</td></tr>
        <tr><th>Attachments</th><td>{{ m.attachmentNames|join(', ') ?: '—' }}</td></tr>
        <tr><th>Status</th><td>{{ m.status|capitalize }} · last change {{ m.updatedAt|date('Y-m-d H:i:s') }} UTC</td></tr>
        <tr><th>Message-ID</th><td><code>{{ m.messageId ?: '—' }}</code></td></tr>
        {% if m.error %}<tr><th>Error</th><td><pre class="log-pre">{{ m.error }}</pre></td></tr>{% endif %}
    </table>
</div>
{% endblock %}
