{% extends 'base.html.twig' %}

{% block title %}{{ own ? 'My API Tokens' : 'API Tokens of ' ~ owner.email }}{% endblock %}

{% block body %}
<h1>{{ own ? 'My API Tokens' : 'API Tokens of ' ~ owner.email }}</h1>

{% for message in app.flashes('success') %}
    <div class="flash-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="error">{{ message }}</div>
{% endfor %}

<p class="api-tokens-help">
    Bearer tokens for the admin REST API (<code>/admin-api</code>). Only a hash of each token is stored, so the
    full value cannot be shown again — the <strong>Ends in</strong> column shows its last 6 characters so you can
    tell which is which. A revoked token is refused (401) immediately and can never be re-enabled.
    New tokens are issued from the server shell: <code>php bin/console app:admin:create-api-token --email={{ owner.email }}</code>.
</p>

{% if not own %}
    <p><a href="{{ path('app_admin_superadmin_admins') }}">&larr; All admins</a></p>
    {% set active = tokens|filter(t => t.active) %}
    {% if active is not empty %}
    <form method="post" action="{{ path('app_admin_support_api_tokens_revoke_all', {adminId: owner.id}) }}"
          onsubmit="return confirm('Revoke every API token of {{ owner.email|e('js') }}?');">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_api_token_revoke_all_' ~ owner.id) }}">
        <button type="submit" class="api-token-revoke-all-btn">Revoke all {{ active|length }} active token(s)</button>
    </form>
    {% endif %}
{% endif %}

<table class="api-tokens">
    <thead>
        <tr>
            <th>Name</th>
            <th>Ends in</th>
            <th>Created</th>
            <th>Expires</th>
            <th>Last used</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for token in tokens %}
        {% set status = token.revoked ? 'revoked' : (token.expired ? 'expired' : 'active') %}
        <tr class="api-token api-token-{{ status }}" data-token-id="{{ token.id }}">
            <td class="api-token-name">{{ token.name }}</td>
            <td class="api-token-hint"><code>{{ token.tokenHint is not null ? '…' ~ token.tokenHint : '(not recorded)' }}</code></td>
            <td>{{ token.createdAt|date('Y-m-d H:i') }}</td>
            <td class="api-token-expiry">{{ token.expiresAt ? token.expiresAt|date('Y-m-d H:i') : 'Never' }}</td>
            <td>{{ token.lastUsedAt ? token.lastUsedAt|date('Y-m-d H:i') : 'Never' }}</td>
            <td class="api-token-status">{{ status }}{% if token.revoked %} ({{ token.revokedAt|date('Y-m-d H:i') }}){% endif %}</td>
            <td>
                {% if not token.revoked %}
                <form method="post" action="{{ own ? path('app_admin_api_tokens_revoke', {id: token.id}) : path('app_admin_support_api_tokens_revoke', {adminId: owner.id, id: token.id}) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_api_token_revoke_' ~ token.id) }}">
                    <button type="submit" class="api-token-revoke-btn">Revoke</button>
                </form>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="7">No API tokens.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
