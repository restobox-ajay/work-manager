{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}
{% import 'event/_macros.html.twig' as em %}

{% block title %}All events{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Events</div>
        <div class="ph-title"><h1>All events</h1></div>
        <p class="lead">Every recorded event, newest date first.</p>
    </div>
    <div class="ph-actions">
        <a class="btn info" href="{{ path('app_event_upcoming') }}">Upcoming</a>
        <a class="btn success" href="{{ path('app_event_new') }}">+ New event</a>
    </div>
</div>
{{ ui.flashes() }}
<form class="table-card mx-form" method="get" action="{{ path('app_event_index') }}" style="margin-bottom:16px">
    <div class="table-header" style="flex-wrap:wrap">
        <input type="search" name="q" value="{{ q }}" placeholder="Title, people or place" aria-label="Search events" style="min-width:220px">
        <select name="category" aria-label="Category" style="width:auto" onchange="this.form.submit()">
            <option value="">All categories</option>
            {% for c in categories %}<option value="{{ c.id }}" {{ categoryId == c.id ? 'selected' }}>{{ c.name }}</option>{% endfor %}
        </select>
        <select name="year" aria-label="Year" style="width:auto" onchange="this.form.submit()">
            <option value="">All years</option>
            {% for y in years %}<option value="{{ y }}" {{ year == y ? 'selected' }}>{{ y }}</option>{% endfor %}
        </select>
        <button class="btn primary sm" type="submit">Filter</button>
        {% if q or categoryId or year %}<a class="btn secondary sm" href="{{ path('app_event_index') }}">Reset</a>{% endif %}
        <span class="grow"></span>
    </div>
</form>
<div class="table-card">
    <div class="tscroll">
        <table class="t">
            <thead><tr><th>Date</th><th>Event</th><th>Category</th><th>People</th><th>Place</th><th>Repeats</th><th>Reminder</th><th></th></tr></thead>
            <tbody>
                {% for e in events %}
                    <tr>
                        <td class="nowrap">{{ e.eventDate|date('M j, Y') }}{% if e.endDate %}<div class="muted small">to {{ e.endDate|date('M j, Y') }}</div>{% endif %}</td>
                        <td><a class="bold" href="{{ path('app_event_show', {id: e.id}) }}">{{ e.title }}</a></td>
                        <td>{{ em.category(e) ?: '—' }}</td>
                        <td>{{ e.people ?: '—' }}</td>
                        <td>{{ e.place ?: '—' }}</td>
                        <td>{{ e.repeatsYearly ? 'Yearly' : '—' }}</td>
                        <td class="nowrap">{{ e.remindDaysBefore is not null ? (e.remindDaysBefore == 0 ? 'On the day' : e.remindDaysBefore ~ 'd before') : '—' }}</td>
                        <td class="actions">
                            <a class="btn primary xs" href="{{ path('app_event_show', {id: e.id}) }}">View</a>
                            <a class="btn warning xs" href="{{ path('app_event_edit', {id: e.id}) }}">Edit</a>
                            {{ ui.deleteButton(path('app_event_delete', {id: e.id}), 'event_delete_' ~ e.id, 'Delete "' ~ e.title ~ '" and its files? This cannot be undone.') }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="empty"><b>No events here.</b> <a href="{{ path('app_event_new') }}">Add one</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
