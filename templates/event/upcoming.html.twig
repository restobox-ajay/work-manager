{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}
{% import 'event/_macros.html.twig' as em %}

{% block title %}Upcoming events{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Events</div>
        <div class="ph-title"><h1>Upcoming</h1></div>
        <p class="lead">What happens in the next {{ days }} days. Yearly events (birthdays, anniversaries, remembrance days) appear every year.</p>
    </div>
    <div class="ph-actions">
        <a class="btn info" href="{{ path('app_event_index') }}">All events</a>
        <a class="btn success" href="{{ path('app_event_new') }}">+ New event</a>
    </div>
</div>
{{ ui.flashes() }}
<nav class="tabs" aria-label="How far ahead">
    {% for d in windows %}<a class="{{ d == days ? 'active' }}" href="{{ path('app_event_upcoming', {days: d}) }}" {{ d == days ? 'aria-current="page"' }}>{{ d == 365 ? 'Next year' : d ~ ' days' }}</a>{% endfor %}
</nav>
<div class="table-card">
    <div class="tscroll">
        <table class="t">
            <thead><tr><th>Date</th><th>When</th><th>Event</th><th>Category</th><th>People</th><th>Place</th><th></th></tr></thead>
            <tbody>
                {% for r in rows %}
                    {% set e = r.event %}
                    <tr>
                        <td class="nowrap bold">{{ r.date|date('D, M j, Y') }}{% if e.eventTime %} <span class="muted">{{ e.eventTime|date('H:i') }}</span>{% endif %}</td>
                        <td class="nowrap">{{ em.when(r.daysAway) }}</td>
                        <td><a class="bold" href="{{ path('app_event_show', {id: e.id}) }}">{{ e.title }}</a> {{ em.years(e, r.years) }}
                            {% if e.repeatsYearly %}<div class="muted small">Every year since {{ e.eventDate|date('M j, Y') }}</div>{% endif %}</td>
                        <td>{{ em.category(e) ?: '—' }}</td>
                        <td>{{ e.people ?: '—' }}</td>
                        <td>{{ e.place ?: '—' }}</td>
                        <td class="actions"><a class="btn primary xs" href="{{ path('app_event_show', {id: e.id}) }}">View</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="empty"><b>Nothing in the next {{ days }} days.</b> <a href="{{ path('app_event_new') }}">Add an event</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
