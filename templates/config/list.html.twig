{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{# One Config list (ADR-073): its own page, CRUD style — the table here, Add and Edit on their own form pages. #}
{% block title %}{{ label.plural }}{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Config</div>
        <div class="ph-title"><h1>{{ label.plural }}</h1></div>
        <p class="lead">
            {% if kind == 'task-statuses' %}Task forms offer the active ones, in this order. Paid is set by the payment flow, not by hand.
            {% elseif kind == 'task-types' %}Task forms offer the active ones. Switch one off rather than removing it: existing tasks keep it.
            {% else %}The currencies a task's payout can be in. CAD's FX rate is CAD per 1 USD.{% endif %}
        </p>
    </div>
    <div class="ph-actions"><a class="btn success" href="{{ path(routeBase ~ '_new') }}">+ Add {{ label.singular|lower }}</a></div>
</div>

{{ ui.flashes() }}

<div class="table-card" style="max-width:900px">
    <table class="t">
        <thead>
            <tr>
                <th style="width:60px">ID</th>
                {% if kind == 'task-statuses' %}<th>Order</th><th>Name</th><th>Active</th>
                {% elseif kind == 'task-types' %}<th>Name</th><th>Description</th><th>Active</th>
                {% else %}<th>Short name</th><th>FX rate</th>{% endif %}
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr>
                    <td class="muted">{{ row.id }}</td>
                    {% if kind == 'task-statuses' %}
                        <td>{{ row.order }}</td><td class="bold">{{ row.name }}</td><td>{{ ui.activeBadge(row.active) }}</td>
                    {% elseif kind == 'task-types' %}
                        <td class="bold">{{ row.name }}</td><td>{{ row.description ?? '—' }}</td><td>{{ ui.activeBadge(row.status) }}</td>
                    {% else %}
                        <td class="bold"><code>{{ row.shortName }}</code></td><td>{{ row.fxRate }}</td>
                    {% endif %}
                    <td class="actions"><a class="btn sm" href="{{ path(routeBase ~ '_edit', {id: row.id}) }}">Edit</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="empty"><b>Nothing here yet.</b></td></tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="table-foot"><span>{{ rows|length }} {{ rows|length == 1 ? label.singular|lower : label.plural|lower }}</span></div>
</div>
{% endblock %}
