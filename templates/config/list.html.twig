{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{# One Config list (ADR-075): its own CRUD page, columns from ConfigListRegistry. Add/Edit are separate form pages. #}
{% block title %}{{ list.plural }}{% endblock %}

{% block body %}
{# ADR-127: no ID column; a list ordered by an Order field is reordered by dragging rows instead of showing the number. #}
{% set sortField = list.sortField %}
{% set sortable = sortField is not null and rows|length > 1 %}
{% set columns = sortField is null ? list.listedFields : list.listedFields|filter(f => f.name != sortField.name) %}
{% import 'layout/_icons.html.twig' as icons %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Config</div>
        <div class="ph-title"><h1>{{ list.plural }}</h1></div>
        <p class="lead">{{ list.lead }}{% if sortable %} Drag a row to change the order — it is saved straight away.{% endif %}</p>
    </div>
    <div class="ph-actions"><a class="btn success" href="{{ path('app_config_new', {kind: list.kind}) }}">+ Add {{ list.singular|lower }}</a></div>
</div>

{{ ui.flashes() }}
<div class="alert success prio-saved" data-sort-saved role="status" hidden></div>

<div class="table-card">
    <div class="tscroll">
        <table class="t">
            <thead>
                <tr>
                    {% if sortField is not null %}<th style="width:36px"></th>{% endif %}
                    {% for field in columns %}<th>{{ field.label }}</th>{% endfor %}
                    <th></th>
                </tr>
            </thead>
            <tbody {% if sortable %}data-sort-list data-action="{{ path('app_config_sort', {kind: list.kind}) }}" data-token="{{ csrf_token('config_sort_' ~ list.kind) }}"{% endif %}>
                {% for row in rows %}
                    <tr data-id="{{ row.id }}" {% if sortable %}class="prio-row" draggable="true" title="Drag to reorder"{% endif %}>
                        {% if sortField is not null %}<td class="prio-handle" aria-hidden="true">{{ sortable ? icons.icon('bars') }}</td>{% endif %}
                        {% for field in columns %}
                            {% set value = attribute(row, field.getter) %}
                            <td{{ loop.first ? ' class="bold"' }}>
                                {%- if field.type == 'checkbox' -%}{{ ui.activeBadge(value) }}
                                {%- elseif field.type == 'choice' -%}{{ field.choices[value.value ?? value] ?? (value.value ?? value) }}
                                {%- elseif field.type == 'user' -%}{{ value ? (people[value] ?? ('#' ~ value)) : '—' }}
                                {%- else -%}{{ value is same as(null) or value is same as('') ? '—' : ui.short(value ~ '', 80) }}
                                {%- endif -%}
                            </td>
                        {% endfor %}
                        <td class="actions">
                            <span class="btn-row" style="justify-content:flex-end">
                                <a class="btn warning sm" href="{{ path('app_config_edit', {kind: list.kind, id: row.id}) }}">Edit</a>
                                {% if list.deletable %}
                                    <form class="mx-form" method="post" action="{{ path('app_config_delete', {kind: list.kind, id: row.id}) }}" onsubmit="return confirm('Delete this {{ list.singular|lower }}?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('config_delete_' ~ list.kind ~ '_' ~ row.id) }}">
                                        <button class="btn danger sm" type="submit">Delete</button>
                                    </form>
                                {% endif %}
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="{{ columns|length + (sortField is null ? 1 : 2) }}" class="empty"><b>Nothing here yet.</b> <a href="{{ path('app_config_new', {kind: list.kind}) }}">Add the first one</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="table-foot"><span>{{ rows|length }} {{ rows|length == 1 ? list.singular|lower : list.plural|lower }}</span></div>
</div>
{% if sortable %}
<script>
    // Drag and drop (ADR-127): drag any row; on drop the new order is posted in the background and confirmed.
    (function () {
        var body = document.querySelector('[data-sort-list]');
        var notice = document.querySelector('[data-sort-saved]');
        var dragged = null, before = '', hideTimer = null;
        function ids() { return Array.prototype.map.call(body.querySelectorAll('tr[data-id]'), function (r) { return r.dataset.id; }); }
        function show(text, ok) {
            notice.textContent = text;
            notice.className = 'alert prio-saved ' + (ok ? 'success' : 'danger');
            notice.hidden = false;
            clearTimeout(hideTimer);
            if (ok) { hideTimer = setTimeout(function () { notice.hidden = true; }, 4000); }
        }
        function save() {
            var data = new FormData();
            data.append('_token', body.dataset.token);
            ids().forEach(function (id) { data.append('ids[]', id); });
            fetch(body.dataset.action, { method: 'POST', body: data, credentials: 'same-origin', headers: { 'X-Requested-With': 'fetch' } })
                .then(function (r) { r.ok ? show('Order saved.', true) : show('Could not save the order — reload the page and try again.', false); })
                .catch(function () { show('Could not save the order — check your connection.', false); });
        }
        body.addEventListener('dragstart', function (e) {
            var row = e.target.closest && e.target.closest('tr.prio-row');
            if (!row) { return; }
            dragged = row; before = ids().join(',');
            row.classList.add('prio-dragging');
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', row.dataset.id);
        });
        body.addEventListener('dragover', function (e) {
            if (!dragged) { return; }
            e.preventDefault();
            var over = e.target.closest('tr[data-id]');
            if (!over || over === dragged) { return; }
            var box = over.getBoundingClientRect();
            body.insertBefore(dragged, e.clientY > box.top + box.height / 2 ? over.nextSibling : over);
        });
        body.addEventListener('drop', function (e) { if (dragged) { e.preventDefault(); } });
        body.addEventListener('dragend', function () {
            if (!dragged) { return; }
            dragged.classList.remove('prio-dragging');
            dragged = null;
            if (ids().join(',') !== before) { save(); }
        });
    })();
</script>
{% endif %}
{% endblock %}
