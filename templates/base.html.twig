<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#206eb8">
        <title>{% block title %}{{ app_name }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {# Runs before the first paint, so a sidebar the user collapsed is drawn collapsed straight away instead of
           drawn open and then snapped shut (a visible flicker on every page load). `js` lets the CSS show controls
           that only work with app.js. Storage can throw (private mode, blocked site data): fall back to open. #}
        <script>
            document.documentElement.classList.add('js');
            try { if (localStorage.getItem('sidebarCollapsed') === '1') { document.documentElement.classList.add('sidebar-collapsed'); } } catch (e) {}
        </script>
        {% block stylesheets %}
        {# app.css is the Maxeme Auto mockup's stylesheet, copied as-is so both share one palette and shell;
           app-bridge.css maps this app's plain page markup (bare h1/form/table) onto it. #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
        <link rel="stylesheet" href="/css/app.css">
        <link rel="stylesheet" href="/css/app-bridge.css">
        {% endblock %}

        {% block javascripts %}
        <script src="/js/app.js" defer></script>
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {# One account type (ADR-068): every signed-in page gets the app shell; what the sidebar offers depends on roles. #}
    {% set signedIn = app.user is not null %}
    {# Rendered once, placed in whichever shell applies below (a block can only be declared once). #}
    {% set pageBody %}{% block body %}{% endblock %}{% endset %}
    <body class="{{ signedIn ? 'site-app' : 'site-auth' }}">
        {% if app.session is defined and app.session.get('_impersonating_as') is not null %}
        <div class="impersonation-banner">
            Impersonating: {{ app.session.get('_impersonating_as') }}
            (as {{ app.session.get('_impersonating_by') }})
            <form method="post" action="{{ path('app_impersonate_exit') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('impersonate_exit') }}">
                <button type="submit" class="exit-impersonation-btn">Exit Impersonation</button>
            </form>
        </div>
        {% endif %}
        {% if signedIn %}
        {% set pageTitle %}{{ block('title') }}{% endset %}
        {% include 'layout/_app_shell.html.twig' %}
        {% else %}
        {# Signed-out pages (login, registration, password reset, …): the mockup's centred sign-in card. #}
        <div class="auth">
            <main id="main-content" class="auth-card page-body">
                <div class="eyebrow">{{ app_name }}</div>
                {{ pageBody }}
            </main>
        </div>
        {% endif %}
    </body>
</html>
