<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#1a2332">
        <title>{% block title %}{{ app_name }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {# theme.css is the wholesale-b2b-core design system, copied as-is so both apps share one look;
           theme-bridge.css maps this app's plain page markup (bare h1/form/table) onto it. Inter is the
           intended face; the theme falls back to the system UI stack if the font never loads. #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
        <link rel="stylesheet" href="/css/theme.css">
        <link rel="stylesheet" href="/css/theme-bridge.css">
        {# Without JavaScript the collapsed sidebar groups could never open: show them all. #}
        <noscript><style>.site-admin .nav-sub-list { max-height: none; opacity: 1; transform: none; visibility: visible !important; }</style></noscript>
        {% endblock %}

        {% block javascripts %}
        <script src="/js/theme.js" defer></script>
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {# One account type (ADR-068): every signed-in page gets the app shell; what the sidebar offers depends on roles. #}
    {% set signedIn = app.user is not null %}
    {% set areaLabel = is_granted('ROLE_ADMIN') ? 'Admin Console' : 'My Account' %}
    {# Rendered once, placed in whichever shell applies below (a block can only be declared once). #}
    {% set pageBody %}{% block body %}{% endblock %}{% endset %}
    <body class="site {{ signedIn ? 'site-admin' : 'site-admin-login' }}">
        {% if app.session is defined and app.session.get('_impersonating_as') is not null %}
        <div class="impersonation-banner">
            Impersonating: {{ app.session.get('_impersonating_as') }}
            (as {{ app.session.get('_impersonating_by') }})
            <form method="post" action="{{ path('app_impersonate_exit') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('impersonate_exit') }}">
                <button type="submit" class="exit-impersonation-btn">Exit Impersonation</button>
            </form>
        </div>
        {% endif %}
        {% if signedIn %}
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <div class="app-shell">
            <aside class="topbar sidebar">
                <a class="brand" href="{{ path('app_dashboard') }}" aria-label="{{ app_name }} home">
                    <span class="brand-copy">
                        {{ app_name }}
                        <small>{{ areaLabel }}</small>
                    </span>
                </a>
                <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Toggle navigation">
                    <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="nav-toggle-label">Menu</span>
                </button>
                <nav id="primary-navigation" class="nav" aria-label="Primary navigation">
                    {% include 'layout/_nav.html.twig' %}
                </nav>
                <button class="sidebar-footer sidebar-collapse-toggle" type="button" aria-label="Collapse sidebar" aria-expanded="true">
                    <span class="sidebar-collapse-icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    </span>
                </button>
            </aside>
            <main id="main-content" class="content-frame">
                {% include 'layout/_content_header.html.twig' %}
                <div class="page-body">{{ pageBody }}</div>
            </main>
            <footer class="site-footer">
                <span>&copy; {{ 'now'|date('Y') }} {{ app_name }}</span>
            </footer>
        </div>
        {% else %}
        {# Signed-out pages (login, registration, password reset, …): the centred sign-in card. #}
        <div class="app-shell">
            <main id="main-content" class="content-frame">
                <div class="admin-login-shell">
                    <div class="admin-login-card">
                        <div class="admin-login-card-head">
                            <div>
                                <p class="eyebrow">{{ app_name }}</p>
                            </div>
                        </div>
                        <div class="page-body">{{ pageBody }}</div>
                    </div>
                </div>
            </main>
        </div>
        {% endif %}
    </body>
</html>
