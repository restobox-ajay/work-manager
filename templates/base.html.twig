<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {# The Compliance Log design system (public/css/app.css) styles bare elements and
           scopes its boilerplate rules to `.main > h1 ~ …`, so the templates below need no
           markup changes. Inter is the intended face; the sheet falls back to the system UI
           stack, so the app still renders correctly if the font never loads. #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
        <link rel="stylesheet" href="/css/app.css">
        {# App-level additions, kept out of app.css so that stays a faithful export. #}
        <link rel="stylesheet" href="/css/app-overrides.css">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.session is defined and app.session.get('_impersonating_as') is not null %}
        <div class="impersonation-banner">
            Impersonating: {{ app.session.get('_impersonating_as') }}
            (as {{ app.session.get('_impersonating_by') }})
            <form method="post" action="{{ path('app_impersonate_exit') }}" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token('impersonate_exit') }}">
                <button type="submit" class="exit-impersonation-btn">Exit Impersonation</button>
            </form>
        </div>
        {% endif %}
        {% if app.session is defined and app.session.get('_impersonating_admin_as') is not null %}
        <div class="admin-impersonation-banner">
            Impersonating Admin: {{ app.session.get('_impersonating_admin_as') }}
            (as {{ app.session.get('_impersonating_admin_by') }})
            <form method="post" action="{{ path('app_admin_impersonate_admin_exit') }}" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_impersonate_exit') }}">
                <button type="submit" class="exit-admin-impersonation-btn">Exit Admin Impersonation</button>
            </form>
        </div>
        {% endif %}
        {# Nav follows the authenticated ENTITY (the security boundary), not a role string. #}
        {% set navType = app.user is instanceof('App\\Entity\\Admin') ? 'admin'
            : (app.user is instanceof('App\\Entity\\User') ? 'user' : null) %}
        <div class="layout {{ navType ? 'layout--with-sidebar' : '' }}">
            {% if navType == 'admin' %}
                <aside class="sidebar">{% include 'layout/_admin_nav.html.twig' %}</aside>
            {% elseif navType == 'user' %}
                <aside class="sidebar">{% include 'layout/_user_nav.html.twig' %}</aside>
            {% endif %}
            <main class="main">{% block body %}{% endblock %}</main>
        </div>
    </body>
</html>
