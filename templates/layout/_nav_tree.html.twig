{#
    Renders the sidebar tree in the Maxeme Auto mockup markup (.nav-group / li.active), so app.css styles it as-is.

    `items`: a list of entries, each either
      - a link:  { label, href, icon, current }
      - a group: { label, icon, children: [ { label, href, current, add? }, ... ] }
    `add` ({ label, href }) is the row's "+" link: a real link with its own accessible name, revealed on hover.
    A group is a <details>: the browser opens and closes it with no script, so nothing re-lays the sidebar out
    after the first paint (the old max-height animation driven from JavaScript was what flickered). The group
    holding the current page is rendered open server-side.
#}
{% import 'layout/_icons.html.twig' as icons %}
{% for item in items %}
    {% if item.children is defined %}
        {% set groupOpen = item.children|filter(child => child.current)|length > 0 %}
        <details class="nav-group"{{ groupOpen ? ' open' }}>
            <summary title="{{ item.label }}">{{ icons.icon(item.icon) }}<span class="nav-label">{{ item.label }}</span><span class="chev" aria-hidden="true">▶</span></summary>
            <ul>
                {% for child in item.children %}
                    <li{{ child.current ? ' class="active"' }}>
                        <a href="{{ child.href }}"{{ child.current ? ' aria-current="page"' }}>{{ child.label }}</a>
                        {%- if child.add ?? null %}<a class="add" href="{{ child.add.href }}" title="{{ child.add.label }}" aria-label="{{ child.add.label }}">+</a>{% endif %}
                    </li>
                {% endfor %}
            </ul>
        </details>
    {% else %}
        <a class="nav-link{{ item.current ? ' active' }}" href="{{ item.href }}" title="{{ item.label }}"{{ item.current ? ' aria-current="page"' }}>{{ icons.icon(item.icon) }}<span class="nav-label">{{ item.label }}</span></a>
    {% endif %}
{% endfor %}
