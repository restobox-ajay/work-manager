{#
    The signed-in shell, in the Maxeme Auto mockup layout: fixed sidebar (brand band, menu groups, collapse
    toggle) and a frame holding the top bar (breadcrumb + account menu), the page and the footer.

    One account type (ADR-068): everyone gets their own account pages; ROLE_ADMIN adds the management pages and
    ROLE_TECH_SUPPORT the maintainer tools. The menu is built here, once, because both the sidebar and the
    breadcrumb read it. Bundle-owned links appear only when their bundle is installed (the `pat_available` /
    `two_factor_available` Twig globals, issue #14).

    Expects from base.html.twig: `pageBody` (the rendered page) and `pageTitle` (the title block, used as the
    breadcrumb for pages that are not in the menu).
#}
{% set cur = app.request.attributes.get('_route') %}
{% set accountLinks = [
    { label: 'Settings', href: path('app_account_settings'), current: cur == 'app_account_settings' },
    { label: 'Change Password', href: path('app_account_change_password'), current: cur == 'app_account_change_password' },
] %}
{% set securityLinks = [
    { label: 'Active Sessions', href: path('app_account_sessions'), current: cur == 'app_account_sessions' },
    { label: 'Login History', href: path('app_account_login_history'), current: cur == 'app_account_login_history' },
] %}
{% if pat_available is defined and pat_available %}
    {% set securityLinks = securityLinks|merge([{ label: 'API Tokens', href: path('app_account_tokens'), current: cur == 'app_account_tokens' }]) %}
{% endif %}
{% if two_factor_available is defined and two_factor_available %}
    {% set securityLinks = securityLinks|merge([{ label: 'Two-Factor Auth', href: path('app_2fa_setup'), current: cur starts with 'app_2fa' }]) %}
{% endif %}
{# Work: one group per module, as wholesale-b2b's sidebar. A row's `add` is its "+" (hover to reveal; always shown on
   touch screens), offered only to someone allowed to add one. #}
{% set me = app.user.id %}
{% set mineFilter = app.request.query.get('assigneeId') == me %}
{% set items = [
    { label: 'Dashboard', icon: 'dashboard', href: path('app_dashboard'), current: cur == 'app_dashboard' },
    { label: 'Tasks', icon: 'check-square', children: [
        { label: 'All Tasks', href: path('app_task_index'), current: cur starts with 'app_task_' and not (cur == 'app_task_index' and mineFilter),
          add: is_granted('TASK_CREATE') ? { label: 'New task', href: path('app_task_create') } : null },
        { label: 'Assigned to Me', href: path('app_task_index', {assigneeId: me}), current: cur == 'app_task_index' and mineFilter },
    ] },
    { label: 'Projects', icon: 'folder', children: [
        { label: 'All Projects', href: path('app_project_index'), current: cur starts with 'app_project_',
          add: is_granted('PROJECT_CREATE') ? { label: 'New project', href: path('app_project_create') } : null },
    ] },
    { label: 'Clients', icon: 'briefcase', children: [
        { label: 'All Clients', href: path('app_client_index'), current: cur starts with 'app_client_',
          add: is_granted('CLIENT_CREATE') ? { label: 'New client', href: path('app_client_create') } : null },
    ] },
    { label: 'My Account', icon: 'user', children: accountLinks },
    { label: 'Security', icon: 'shield', children: securityLinks },
] %}
{% if is_granted('ROLE_ADMIN') %}
    {% set items = items|merge([
        { label: 'Users', icon: 'users', children: [
            { label: 'All Users', href: path('app_admin_users'), current: cur starts with 'app_admin_users' and cur != 'app_admin_users_invite' and cur != 'app_admin_users_invitations',
              add: { label: 'New user', href: path('app_admin_users_new') } },
            { label: 'Invite User', href: path('app_admin_users_invite'), current: cur == 'app_admin_users_invite' },
            { label: 'Invitations', href: path('app_admin_users_invitations'), current: cur == 'app_admin_users_invitations' },
        ] },
        { label: 'Settings', icon: 'sliders', children: [
            { label: 'Task Statuses', href: path('app_settings_list', {kind: 'task-statuses'}), current: cur starts with 'app_settings_' and app.request.attributes.get('kind') == 'task-statuses',
              add: { label: 'New task status', href: path('app_settings_list', {kind: 'task-statuses', add: 1}) } },
            { label: 'Task Types', href: path('app_settings_list', {kind: 'task-types'}), current: cur starts with 'app_settings_' and app.request.attributes.get('kind') == 'task-types',
              add: { label: 'New task type', href: path('app_settings_list', {kind: 'task-types', add: 1}) } },
            { label: 'Currencies', href: path('app_settings_list', {kind: 'currencies'}), current: cur starts with 'app_settings_' and app.request.attributes.get('kind') == 'currencies',
              add: { label: 'New currency', href: path('app_settings_list', {kind: 'currencies', add: 1}) } },
        ] },
        { label: 'Administration', icon: 'settings', children: [
            { label: 'Overview', href: path('app_admin_dashboard'), current: cur == 'app_admin_dashboard' },
            { label: 'Audit Log', href: path('app_admin_audit_log'), current: cur == 'app_admin_audit_log' },
            { label: 'Config', href: path('app_admin_config'), current: cur == 'app_admin_config' },
            { label: 'API Docs', href: path('app_admin_api_docs'), current: cur starts with 'app_admin_api_docs' },
        ] },
    ]) %}
{% endif %}
{% if is_granted('ROLE_TECH_SUPPORT') %}
    {% set items = items|merge([
        { label: 'Maintainer', icon: 'tool', children: [
            { label: 'DB Console', href: path('app_admin_db_console'), current: cur starts with 'app_admin_db' },
            { label: 'Htaccess Lock', href: path('app_admin_htaccess_lock'), current: cur starts with 'app_admin_htaccess_lock' },
        ] },
    ]) %}
{% endif %}

{# Breadcrumb, as in the mockup ("Group › Page"): taken from the menu entry for the current page. #}
{% set currentGroup = items|filter(item => item.children is defined and item.children|filter(child => child.current)|length > 0)|first %}
{% set currentLink = items|filter(item => item.children is not defined and item.current)|first %}
{% if currentGroup %}
    {% set crumb = currentGroup.label ~ ' › ' ~ (currentGroup.children|filter(child => child.current)|first).label %}
{% elseif currentLink %}
    {% set crumb = currentLink.label %}
{% else %}
    {% set crumb = pageTitle|trim != app_name ? pageTitle|trim : '' %}
{% endif %}

<a class="skip-link" href="#main-content">Skip to main content</a>
<aside class="sidebar" id="primary-sidebar">
    <a class="brand" href="{{ path('app_dashboard') }}" aria-label="{{ app_name }} home">
        <i class="brand-short" aria-hidden="true">{{ app_name|first }}</i><b>{{ app_name }}</b><span>{{ is_granted('ROLE_ADMIN') ? 'Admin Console' : 'My Account' }}</span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
        {{ include('layout/_nav_tree.html.twig', { items: items }, with_context = false) }}
    </nav>
    {# Shown only once app.js is running (html.js): without it the button would do nothing. #}
    <button class="sb-foot sidebar-collapse-toggle" type="button" aria-controls="primary-sidebar" aria-expanded="true">
        <span class="sb-foot-icon" aria-hidden="true">‹</span><span class="nav-label">Collapse</span>
    </button>
</aside>
<div class="frame">
    {% include 'layout/_content_header.html.twig' with { crumb: crumb } %}
    <main id="main-content" class="content page-body">{{ pageBody }}</main>
    <footer class="footer">&copy; {{ 'now'|date('Y') }} {{ app_name }}</footer>
</div>
