{# The slim bar above every signed-in page: the account menu, as in the wholesale-b2b admin console. #}
{% import 'layout/_icons.html.twig' as icons %}
{% set identifier = app.user.userIdentifier %}
{% set menuLinks = [
    { label: 'Settings', icon: 'user', href: path('app_account_settings') },
    { label: 'Active Sessions', icon: 'monitor', href: path('app_account_sessions') },
    { label: 'Logout', icon: 'logout', href: path('app_logout') },
] %}
<div class="admin-content-header">
    <div class="user-menu">
        <button class="user-menu-toggle" type="button" aria-expanded="false" aria-haspopup="true">
            <span class="user-menu-avatar" aria-hidden="true">{{ identifier|first|upper }}</span>
            <span class="user-menu-email">{{ identifier }}</span>
            <span class="user-menu-caret" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 8 12 16 20 8"></polyline></svg>
            </span>
        </button>
        <div class="user-menu-dropdown" role="menu">
            {% for link in menuLinks %}
                <a href="{{ link.href }}" role="menuitem"><span class="user-menu-item-icon">{{ icons.icon(link.icon) }}</span>{{ link.label }}</a>
            {% endfor %}
        </div>
    </div>
</div>
