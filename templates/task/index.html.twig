{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{% block title %}Tasks{% endblock %}

{% block body %}
{% set params = filters|filter((v, k) => v is not null)|merge({sort: sort}) %}
{% set named = (filters.clientId and filters.clientId != noneId) or (filters.projectId and filters.projectId != noneId) %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Work</div>
        <div class="ph-title"><h1>Tasks</h1></div>
        <p class="lead">
            {% if named %}Everything under the chosen client or project, archived work included (tagged).
            {% else %}Tasks under archived projects or clients are hidden; choose a client or project to see them.{% endif %}
        </p>
    </div>
    {% if is_granted('TASK_CREATE') %}
        <div class="ph-actions"><a class="btn success" href="{{ path('app_task_create', {projectId: filters.projectId > 0 ? filters.projectId : null}) }}">+ New task</a></div>
    {% endif %}
</div>

{{ ui.flashes() }}

<div class="table-card">
    <form class="table-header mx-form" method="get" action="{{ path('app_task_index') }}" style="flex-wrap:wrap">
        <input type="search" name="q" value="{{ filters.q }}" placeholder="Task, project or client" aria-label="Search tasks">
        <select name="clientId" aria-label="Client" style="width:auto;max-width:180px">
            <option value="">All clients</option>
            <option value="{{ noneId }}" {{ filters.clientId == noneId ? 'selected' }}>(no client)</option>
            {% for client in clients %}<option value="{{ client.id }}" {{ filters.clientId == client.id ? 'selected' }}>{{ client.name }}</option>{% endfor %}
        </select>
        <select name="projectId" aria-label="Project" style="width:auto;max-width:200px">
            <option value="">All projects</option>
            <option value="{{ noneId }}" {{ filters.projectId == noneId ? 'selected' }}>(no project)</option>
            {% for project in projects %}<option value="{{ project.id }}" {{ filters.projectId == project.id ? 'selected' }}>{{ project.client.name }} › {{ project.name }}</option>{% endfor %}
        </select>
        <select name="assigneeId" aria-label="Contractor" style="width:auto;max-width:170px">
            <option value="">All contractors</option>
            <option value="{{ app.user.id }}" {{ filters.assigneeId == app.user.id ? 'selected' }}>Assigned to me</option>
            {% for id, name in people %}{% if id != app.user.id %}<option value="{{ id }}" {{ filters.assigneeId == id ? 'selected' }}>{{ name }}</option>{% endif %}{% endfor %}
        </select>
        <select name="taskStatusId" aria-label="Status" style="width:auto">
            <option value="">All statuses</option>
            {% for id, name in statuses %}<option value="{{ id }}" {{ filters.taskStatusId == id ? 'selected' }}>{{ name }}</option>{% endfor %}
        </select>
        <select name="taskTypeId" aria-label="Task type" style="width:auto">
            <option value="">All types</option>
            {% for id, name in types %}<option value="{{ id }}" {{ filters.taskTypeId == id ? 'selected' }}>{{ name }}</option>{% endfor %}
        </select>
        <button class="btn sm" type="submit">Filter</button>
        {% if params|length > 1 %}<a class="btn sm outline" href="{{ path('app_task_index') }}">Reset</a>{% endif %}
    </form>
    <div class="tscroll">
        <table class="t">
            <thead>
                <tr>
                    {{ ui.sortHeader('client', 'Client', sort, 'app_task_index', params) }}
                    {{ ui.sortHeader('project', 'Project', sort, 'app_task_index', params) }}
                    {{ ui.sortHeader('name', 'Task Name', sort, 'app_task_index', params) }}
                    <th>Status Detail</th>
                    <th>Task Type</th>
                    {{ ui.sortHeader('dueDate', 'Due Date', sort, 'app_task_index', params) }}
                    {{ ui.sortHeader('createdAt', 'Created', sort, 'app_task_index', params) }}
                    <th>Contractor</th>
                    <th>Reviewer</th>
                    <th>Status</th>
                    {{ ui.sortHeader('timeBudget', 'Billable (min)', sort, 'app_task_index', params) }}
                    {{ ui.sortHeader('billableDate', 'Billable Date', sort, 'app_task_index', params) }}
                    <th>Currency</th>
                    {{ ui.sortHeader('totalAmount', 'Payout', sort, 'app_task_index', params) }}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for task in page.items %}
                    {% set row = rows[task.id] %}
                    <tr>
                        <td>{{ task.project ? task.project.client.name : '—' }}</td>
                        <td>{% if task.project %}<a href="{{ path('app_project_view', {id: task.project.id}) }}">{{ task.project.name }}</a> {{ ui.archivedTag(row.archived) }}{% else %}—{% endif %}</td>
                        <td><a class="bold" href="{{ path('app_task_view', {id: task.id}) }}">{{ ui.short(task.name, 80) }}</a></td>
                        <td class="small">{{ task.statusDetail ? ui.short(task.statusDetail, 60) : '—' }}</td>
                        <td>{{ types[task.taskTypeId] ?? '—' }}</td>
                        <td class="nowrap">{{ ui.ts(task.dueDate) }}</td>
                        <td class="nowrap">{{ ui.ts(task.createdAt) }}</td>
                        <td>{{ task.assignee ? (task.assignee.name ?: task.assignee.email) : '—' }}</td>
                        <td>{{ people[task.reviewerUserId] ?? '—' }}</td>
                        <td>{{ ui.statusBadge(task.taskStatusId, statuses) }}</td>
                        {% if row.canSeeFee %}
                            <td class="right">{{ task.timeBudget ?? '—' }}</td>
                            <td class="nowrap">{{ task.billableDate ? task.billableDate|date('Y-m-d') : '—' }}</td>
                            <td>{{ currencies[task.currencyId] ?? '—' }}</td>
                            <td class="right nowrap">{{ task.totalAmount ?? '—' }}</td>
                        {% else %}
                            <td colspan="4" class="muted small center">—</td>
                        {% endif %}
                        <td class="actions">
                            {% if row.canEdit %}<a class="btn xs" href="{{ path('app_task_edit', {id: task.id}) }}">Edit</a>{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="15" class="empty"><b>No tasks found.</b>{% if not named %} Tasks under archived work appear when you pick their client or project.{% endif %}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ ui.pager(page, 'app_task_index', params) }}
</div>
{% endblock %}
