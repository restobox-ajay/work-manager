{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{% block title %}Tasks{% endblock %}

{% block body %}
{% set params = filters|filter((v, k) => v is not null)|merge({sort: sort}) %}
{% set named = (filters.clientId and filters.clientId != noneId) or (filters.projectId and filters.projectId != noneId) %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Tasks</div>
        <div class="ph-title"><h1>{{ sideList == 'contractors' ? 'Tasks by contractor' : 'Tasks by client / project' }}</h1></div>
        <p class="lead">
            {% if named %}Everything under the chosen client or project, archived work included (tagged).
            {% else %}Tasks under archived projects or clients are hidden; choose a client or project to see them.{% endif %}
        </p>
    </div>
    {% if is_granted('TASK_CREATE') %}
        <div class="ph-actions"><a class="btn success" href="{{ path('app_task_create', {projectId: filters.projectId > 0 ? filters.projectId : null}) }}">+ New task</a></div>
    {% endif %}
</div>

{{ ui.flashes() }}

{# The side list picks the client/project (or contractor) the way work-platform's list pages did; the filters
   above the table narrow further. Links keep the status filter. #}
{% set keep = {taskStatusId: filters.taskStatusId, sort: sort ?: null} %}
<div class="split dash-split">
    <nav class="card" aria-label="{{ sideList == 'contractors' ? 'Contractors' : 'Clients' }}" style="padding:12px 0">
        {% if sideList == 'contractors' %}
            <div class="section-label" style="padding:0 14px 4px;margin:0 0 4px">Select contractor</div>
            <ul class="dash-clients">
                <li class="{{ filters.assigneeId is null ? 'active' }}"><a href="{{ path(listRoute, keep) }}">All contractors</a></li>
                {% for person in contractors %}
                    <li class="{{ filters.assigneeId == person.id ? 'active' }}"><a href="{{ path(listRoute, keep|merge({assigneeId: person.id})) }}" title="{{ person.email }}">{{ person.name ?: person.email }}</a></li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="section-label" style="padding:0 14px 4px;margin:0 0 4px">Select client</div>
            <ul class="dash-clients">
                <li class="{{ filters.clientId is null and filters.projectId is null ? 'active' }}"><a href="{{ path(listRoute, keep) }}">All clients</a></li>
                {% for client in clients %}
                    <li class="{{ filters.clientId == client.id and filters.projectId is null ? 'active' }}">
                        <a href="{{ path(listRoute, keep|merge({clientId: client.id})) }}" title="{{ client.name }}">{{ client.name }}</a>
                        {% if filters.clientId == client.id %}
                            <ul>
                                {% for project in projects %}
                                    <li class="{{ filters.projectId == project.id ? 'active' }}"><a href="{{ path(listRoute, keep|merge({clientId: client.id, projectId: project.id})) }}" title="{{ project.name }}">{{ project.name }}</a></li>
                                {% endfor %}
                                <li class="{{ filters.projectId == noneId ? 'active' }}"><a href="{{ path(listRoute, keep|merge({clientId: client.id, projectId: noneId})) }}">(no project)</a></li>
                            </ul>
                        {% endif %}
                    </li>
                {% endfor %}
                <li class="{{ filters.clientId == noneId ? 'active' }}"><a href="{{ path(listRoute, keep|merge({clientId: noneId})) }}">(no client)</a></li>
            </ul>
        {% endif %}
    </nav>
<div class="table-card" style="min-width:0">
    <form class="table-header mx-form" method="get" action="{{ path(listRoute) }}" style="flex-wrap:wrap">
        <input type="search" name="q" value="{{ filters.q }}" placeholder="Task, project or client" aria-label="Search tasks">
        <select name="clientId" aria-label="Client" style="width:auto;max-width:180px">
            <option value="">All clients</option>
            <option value="{{ noneId }}" {{ filters.clientId == noneId ? 'selected' }}>(no client)</option>
            {% for client in clients %}<option value="{{ client.id }}" {{ filters.clientId == client.id ? 'selected' }}>{{ client.name }}</option>{% endfor %}
        </select>
        <select name="projectId" aria-label="Project" style="width:auto;max-width:200px">
            <option value="">All projects</option>
            <option value="{{ noneId }}" {{ filters.projectId == noneId ? 'selected' }}>(no project)</option>
            {% for project in projects %}<option value="{{ project.id }}" {{ filters.projectId == project.id ? 'selected' }}>{{ project.client.name }} › {{ project.name }}</option>{% endfor %}
        </select>
        {# No contractor filter (ADR-100); a contractor picked in the side list or a dashboard link survives filtering. #}
        {% if filters.assigneeId is not null %}<input type="hidden" name="assigneeId" value="{{ filters.assigneeId }}">{% endif %}
        <select name="taskStatusId" aria-label="Status" style="width:auto">
            <option value="">All statuses</option>
            {% for id, name in statuses %}<option value="{{ id }}" {{ filters.taskStatusId == id ? 'selected' }}>{{ name }}</option>{% endfor %}
        </select>
        <select name="taskTypeId" aria-label="Task type" style="width:auto">
            <option value="">All types</option>
            {% for id, name in types %}<option value="{{ id }}" {{ filters.taskTypeId == id ? 'selected' }}>{{ name }}</option>{% endfor %}
        </select>
        <button class="btn primary sm" type="submit">Filter</button>
        {% if params|length > 1 %}<a class="btn secondary sm" href="{{ path(listRoute) }}">Reset</a>{% endif %}
    </form>
    <div class="tscroll">
        <table class="t">
            <thead>
                <tr>
                    {{ ui.sortHeader('client', 'Client', sort, listRoute, params) }}
                    {{ ui.sortHeader('project', 'Project', sort, listRoute, params) }}
                    {{ ui.sortHeader('name', 'Task Name', sort, listRoute, params) }}
                    <th>Status Detail</th>
                    <th>Task Type</th>
                    {{ ui.sortHeader('dueDate', 'Due Date', sort, listRoute, params) }}
                    {{ ui.sortHeader('createdAt', 'Created', sort, listRoute, params) }}
                    <th>Status</th>
                    <th>Currency</th>
                    {{ ui.sortHeader('totalAmount', 'Payout', sort, listRoute, params) }}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for task in page.items %}
                    {% set row = rows[task.id] %}
                    <tr>
                        <td>{{ task.project ? task.project.client.name : '—' }}</td>
                        <td>{% if task.project %}<a href="{{ path('app_project_view', {id: task.project.id}) }}">{{ task.project.name }}</a> {{ ui.archivedTag(row.archived) }}{% else %}—{% endif %}</td>
                        <td><a class="bold" href="{{ path('app_task_view', {id: task.id}) }}">{{ ui.short(task.name, 80) }}</a></td>
                        <td class="small">{{ task.statusDetail ? ui.short(task.statusDetail, 60) : '—' }}</td>
                        <td>{{ types[task.taskTypeId] ?? '—' }}</td>
                        <td class="nowrap">{{ ui.ts(task.dueDate) }}</td>
                        <td class="nowrap">{{ ui.ts(task.createdAt) }}</td>
                        <td>{{ ui.statusBadge(task.taskStatusId, statuses) }}</td>
                        {% if row.canSeeFee %}
                            <td>{{ currencies[task.currencyId] ?? '—' }}</td>
                            <td class="right nowrap">{{ task.totalAmount ?? '—' }}</td>
                        {% else %}
                            <td colspan="2" class="muted small center">—</td>
                        {% endif %}
                        <td class="actions">
                            <a class="btn primary xs" href="{{ path('app_task_view', {id: task.id}) }}">View</a>
                            {% if row.canEdit %}<a class="btn warning xs" href="{{ path('app_task_edit', {id: task.id}) }}">Edit</a>{% endif %}
                            {% if row.canDelete %}{{ ui.deleteButton(path('app_task_delete', {id: task.id}), 'task_delete_' ~ task.id, 'Delete this task?') }}{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="11" class="empty"><b>No tasks found.</b>{% if not named %} Tasks under archived work appear when you pick their client or project.{% endif %}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {{ ui.pager(page, listRoute, params) }}
</div>
</div>
{% endblock %}
