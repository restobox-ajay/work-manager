{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{#
    Authorization Queue (ADR-072): tasks and budget requests a Contractor filed, waiting for a reviewer (the
    project's Project Manager, the client's Client Manager, or an admin). Approve makes it normal work.
#}
{% block title %}Authorization queue{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">Tasks</div>
        <div class="ph-title"><h1>Authorization queue</h1></div>
        <p class="lead">Approve a request to turn it into a normal task; deny it to close it.</p>
    </div>
</div>

{{ ui.flashes() }}

<nav class="tabs" aria-label="Queue">
    <a href="{{ path('app_task_queue') }}" class="{{ show == 'pending' ? 'active' }}">Waiting</a>
    <a href="{{ path('app_task_queue', {show: 'decided'}) }}" class="{{ show == 'decided' ? 'active' }}">Decided</a>
</nav>

<div class="table-card">
    <form class="table-header mx-form" method="get" action="{{ path('app_task_queue') }}">
        <input type="hidden" name="show" value="{{ show }}">
        <input type="search" name="q" value="{{ q }}" placeholder="Task name" aria-label="Search">
        <select name="clientId" aria-label="Client" style="width:auto;max-width:220px">
            <option value="">All clients</option>
            {% for client in clients %}<option value="{{ client.id }}" {{ clientId == client.id ? 'selected' }}>{{ client.name }}</option>{% endfor %}
        </select>
        <button class="btn sm" type="submit">Filter</button>
    </form>
    <div class="tscroll">
        <table class="t">
            <thead><tr><th>Client</th><th>Project</th><th>Task</th><th>Requested by</th><th>Why</th><th>Payout</th><th>{{ show == 'decided' ? 'Decision' : '' }}</th></tr></thead>
            <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>{{ task.project ? task.project.client.name : '—' }}</td>
                        <td>{{ task.project ? task.project.name : '—' }}</td>
                        <td><a class="bold" href="{{ path('app_task_view', {id: task.id}) }}">{{ ui.short(task.name, 80) }}</a></td>
                        <td>{{ people[task.createdBy] ?? '—' }}</td>
                        <td class="small">{{ task.authorizedDescription ? ui.short(task.authorizedDescription, 80) : '—' }}</td>
                        <td class="nowrap">{{ is_granted('TASK_FEE', task) ? (task.totalAmount ?? '0.00') ~ ' ' ~ (currencies[task.currencyId] ?? '') : '—' }}</td>
                        <td class="actions">
                            {% if show == 'decided' %}
                                <span class="badge {{ task.authorizedStatus == 'Approve' ? 'success' : (task.authorizedStatus == 'Deny' ? 'danger' : 'plain') }}">{{ task.authorizedStatus }}</span>
                            {% elseif canReview[task.id] %}
                                <form class="mx-form btn-row" method="post" action="{{ path('app_task_authorization', {id: task.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('task_authorization_' ~ task.id) }}">
                                    <button class="btn sm success" type="submit" name="decision" value="Approve">Approve</button>
                                    <button class="btn sm danger" type="submit" name="decision" value="Deny">Deny</button>
                                </form>
                            {% else %}
                                <span class="muted small">Waiting for a reviewer</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="empty"><b>{{ show == 'decided' ? 'No decisions yet.' : 'Nothing waiting.' }}</b></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
