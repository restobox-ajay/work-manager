{% extends 'base.html.twig' %}
{% import '_work/macros.html.twig' as ui %}

{% block title %}Task #{{ task.id }}{% endblock %}

{% block body %}
<div class="page-head">
    <div class="ph-main">
        <div class="eyebrow">
            {% if task.project %}
                <a href="{{ path('app_client_view', {id: task.project.client.id}) }}" style="color:inherit">{{ task.project.client.name }}</a> ›
                <a href="{{ path('app_project_view', {id: task.project.id}) }}" style="color:inherit">{{ task.project.name }}</a>
            {% else %}No project{% endif %}
            · Task #{{ task.id }}
        </div>
        <div class="ph-title"><h1 style="text-transform:none;letter-spacing:0;font-size:1.05rem">{{ task.name }}</h1> {{ ui.statusBadge(task.taskStatusId, statuses) }} {{ ui.archivedTag(archivedReasons) }}</div>
    </div>
    <div class="ph-actions">
        <a class="btn secondary back" href="{{ path('app_task_index') }}">Tasks</a>
        {% if is_granted('TASK_EDIT', task) %}<a class="btn warning" href="{{ path('app_task_edit', {id: task.id}) }}">Edit</a>{% endif %}
    </div>
</div>

{{ ui.flashes() }}

{% if archivedReasons is not empty %}
    <div class="alert warn">
        <b>This task is hidden from the unfiltered task list.</b>
        {% for reason in archivedReasons %}<div>{{ reason }}</div>{% endfor %}
    </div>
{% endif %}

<div class="detail">
    <div>
        {% if task.description %}<div class="card"><h2>Description</h2><div class="rich-text">{{ task.description|rich_text }}</div></div>{% endif %}
        {% if task.tutorial %}<div class="card"><h2>Tutorial</h2><div style="white-space:pre-line">{{ task.tutorial }}</div></div>{% endif %}

        <div class="card">
            <h2>Status detail</h2>
            {% if is_granted('TASK_STATUS_DETAIL', task) %}
                <form class="mx-form" method="post" action="{{ path('app_task_status_detail', {id: task.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('task_status_detail_' ~ task.id) }}">
                    <textarea name="statusDetail" rows="4" aria-label="Status detail" placeholder="Where this task stands">{{ task.statusDetail }}</textarea>
                    <div class="btn-row" style="justify-content:flex-end;margin-top:8px"><button class="btn primary" type="submit">Save</button></div>
                </form>
            {% else %}
                <p style="white-space:pre-line">{{ task.statusDetail ?? '—' }}</p>
            {% endif %}
        </div>
    </div>
    <div>
        {# ADR-121: every detail of the task (contractor, reviewer and billable fields stay hidden, ADR-100). #}
        <div class="card">
            <h2>Details</h2>
            <dl class="kv">
                <dt>Task</dt><dd>#{{ task.id }}</dd>
                <dt>Client</dt><dd>{% if task.project %}<a href="{{ path('app_client_view', {id: task.project.client.id}) }}">{{ task.project.client.name }}</a>{% else %}—{% endif %}</dd>
                <dt>Project</dt><dd>{% if task.project %}<a href="{{ path('app_project_view', {id: task.project.id}) }}">{{ task.project.name }}</a> {{ ui.archivedTag(archivedReasons) }}{% else %}—{% endif %}</dd>
                <dt>Status</dt><dd>{{ ui.statusBadge(task.taskStatusId, statuses) }}</dd>
                <dt>Task type</dt><dd>{{ types[task.taskTypeId] ?? '—' }}</dd>
                <dt>Doc / Specs</dt><dd style="overflow-wrap:anywhere">
                    {# Only an http(s) value becomes a link, so a stored "javascript:" can never be clicked. #}
                    {% if not task.docUrl %}—{% elseif task.docUrl starts with 'http://' or task.docUrl starts with 'https://' %}<a href="{{ task.docUrl }}" rel="noopener noreferrer" target="_blank">{{ task.docUrl }}</a>{% else %}{{ task.docUrl }}{% endif %}
                </dd>
                <dt>Notes</dt><dd>{{ notes|length }}</dd>
            </dl>
        </div>
        <div class="card">
            <h2>Dates</h2>
            <dl class="kv">
                <dt>Due</dt><dd>{{ ui.ts(task.dueDate) }}{% if task.dueDate and task.dueDate < date().timestamp and task.taskStatusId == constant('App\\Entity\\Settings\\TaskStatus::PENDING_ID') %} <span class="badge danger">Overdue</span>{% endif %}</dd>
                <dt>Creation date</dt><dd>{{ task.creationDate ? task.creationDate|date('Y-m-d') : '—' }}</dd>
                <dt>Entered</dt><dd>{{ ui.ts(task.createdAt, 'Y-m-d H:i') }}{% if task.createdBy %} by {{ people[task.createdBy] ?? ('#' ~ task.createdBy) }}{% endif %}</dd>
                <dt>Last updated</dt><dd>{{ ui.ts(task.updatedAt, 'Y-m-d H:i') }}{% if task.updatedBy %} by {{ people[task.updatedBy] ?? ('#' ~ task.updatedBy) }}{% endif %}</dd>
                <dt>Approved</dt><dd>{{ ui.ts(task.approvedDate) }}{% if task.approvedDate and task.approvedBy %} by {{ people[task.approvedBy] ?? ('#' ~ task.approvedBy) }}{% endif %}</dd>
                <dt>Paid</dt><dd>{{ ui.ts(task.paidDate) }}{% if task.paidDate and task.paidBy %} by {{ people[task.paidBy] ?? ('#' ~ task.paidBy) }}{% endif %}</dd>
            </dl>
        </div>
        {% if is_granted('TASK_FEE', task) %}
            <div class="card">
                <h2>Payout</h2>
                <dl class="kv">
                    <dt>Amount</dt><dd>{{ task.totalAmount ?? '0.00' }} {{ currencies[task.currencyId] ?? '' }}</dd>
                    <dt>Payment</dt><dd>{{ task.paymentId ?: '—' }}</dd>
                </dl>
            </div>
        {% endif %}
        {% if is_granted('TASK_DELETE', task) %}
            <form class="mx-form" method="post" action="{{ path('app_task_delete', {id: task.id}) }}" onsubmit="return confirm('Delete this task?');">
                <input type="hidden" name="_token" value="{{ csrf_token('task_delete_' ~ task.id) }}">
                <button class="btn danger block" type="submit">Delete task</button>
            </form>
        {% endif %}
    </div>
</div>

{% import 'note/_macros.html.twig' as n %}
{{ n.panel(notes, {task: task.id}) }}
{% endblock %}
