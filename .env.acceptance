APP_ENV=acceptance
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=weak
KERNEL_CLASS='App\Kernel'

###> symfony/framework-bundle ###
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

###> domains ###
# The acceptance live server (PhpBuiltinServerExtension) binds to 127.0.0.1 and
# is reached at http://127.0.0.1:8899, so the firewall host matchers must match
# that host. Both domains are the same host here = single-domain mode.
APP_DOMAIN=127.0.0.1
ADMIN_DOMAIN=127.0.0.1
SESSION_COOKIE_DOMAIN=
###< domains ###
