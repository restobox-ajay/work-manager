APP_ENV=acceptance
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=weak
KERNEL_CLASS='App\Kernel'

###> symfony/framework-bundle ###
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PHPUnit and the Codeception live server share ONE MySQL test database; bin/verify-fast.sh drops and
# re-migrates it before each suite. Override credentials in the gitignored .env.test.local / .env.acceptance.local.
DATABASE_URL="mysql://root:@127.0.0.1:3306/work_manager_test?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

###> domains ###
# The acceptance live server (PhpBuiltinServerExtension) binds to 127.0.0.1 and
# is reached at http://127.0.0.1:8899, so the firewall host matchers must match
# that host. Both domains are the same host here = single-domain mode.
APP_DOMAIN=127.0.0.1
ADMIN_DOMAIN=127.0.0.1
SESSION_COOKIE_DOMAIN=
###< domains ###
